# Copy to .env and fill in. NEVER commit .env.
# Stage 1 (classifier training, API, demo) needs NO keys.
# Keys are only used by the Stage 2 Chairman harness when calling live providers.

# --- Direct provider adapter (Stage 2) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- BlackBox Agents API adapter (Stage 2, optional) ---
# Free-tier bb_ key. The adapter ships with mocked unit tests; a real key is
# only needed to run it live.
BLACKBOX_API_KEY=
BLACKBOX_API_BASE=https://cloud.blackbox.ai/api

# --- Harness configuration (overridable; see src/agenclave/config.py) ---
# Provider backend for the agents: "direct" or "blackbox"
AGENCLAVE_PROVIDER=direct
# Comma-separated agent models for best-of-N dispatch (direct adapter)
AGENCLAVE_AGENT_MODELS=claude-sonnet-4-6,gpt-4o-mini
# Chairman judge model
AGENCLAVE_CHAIRMAN_MODEL=claude-opus-4-8
